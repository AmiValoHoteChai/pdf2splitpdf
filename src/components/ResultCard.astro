---
// src/components/ResultCard.astro
---
<div class="state-view hidden" id="stateSuccess">
  <div class="success-header">
    <div class="success-header-left">
      <div class="success-icon-box">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <div class="success-text">
        <h3 class="success-title">PDF split successfully</h3>
        <p class="success-subtitle" id="successTimeInfo">Processed in-browser</p>
      </div>
    </div>

    <!-- Top-Right Actions -->
    <div class="success-header-actions">
      <button type="button" class="btn btn-secondary btn-sm" id="splitAnotherBtn">Split Another</button>
      <button type="button" class="btn btn-primary btn-sm" id="downloadZipBtn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>Download All (ZIP)</span>
      </button>
    </div>
  </div>

  <!-- Document Stats Bar -->
  <div class="doc-stats-bar">
    <div class="doc-stats-items">
      <div class="doc-stat-item">
        <span class="stat-label">Split Pieces</span>
        <span class="stat-val" id="statPieces">0</span>
      </div>
      <div class="doc-stat-divider"></div>
      <div class="doc-stat-item">
        <span class="stat-label">Total Pages</span>
        <span class="stat-val" id="statPages">0</span>
      </div>
      <div class="doc-stat-divider"></div>
      <div class="doc-stat-item">
        <span class="stat-label">Total Size</span>
        <span class="stat-val" id="statSize">0 KB</span>
      </div>
    </div>
  </div>

  <!-- Generated PDF Pieces List -->
  <div class="split-results-container" id="splitResultsList">
    <!-- Generated items will be rendered here -->
  </div>

  <!-- Bottom Result Actions -->
  <div class="result-bottom-actions" id="resultBottomActions">
    <button type="button" class="btn btn-secondary btn-back-studio" id="btnBackToStudio">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="23 7 16 12 23 17 23 7"></polygon>
        <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
      </svg>
      <span>Back to Studio Editor</span>
    </button>
  </div>
</div>
