---
// src/components/VisualTrimmerModal.astro
---
<div class="video-trimmer-modal hidden" id="visualTrimmerModal" role="dialog" aria-modal="true" aria-label="Visual PDF Trimmer Studio">
  <div class="trimmer-backdrop"></div>
  
  <div class="trimmer-studio-container">
    <!-- Top Header (Clean, Focused, Minimal) -->
    <header class="trimmer-header">
      <div class="trimmer-header-left">
        <div class="trimmer-title-group">
          <div class="trimmer-studio-badge">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polygon points="23 7 16 12 23 17 23 7"></polygon>
              <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
            </svg>
            <span>TIMELINE TRIMMER</span>
          </div>
          <h2 class="trimmer-doc-name" id="trimmerDocName">document.pdf</h2>
        </div>
      </div>

      <div class="trimmer-header-center">
        <!-- Real-time Stats & Plan Preview -->
        <div class="trimmer-stats-badge" id="trimmerStatsBadge">
          <div class="stats-icon-wrap">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
          </div>
          <span class="range-pill" id="trimmerRangePill">Pages 1 – 5</span>
          <div class="stats-divider"></div>
          <span class="range-selected-tag" id="trimmerRangeDetail">5 pages selected</span>
          <span class="range-omitted-tag" id="trimmerOmittedDetail"></span>
        </div>
      </div>

      <div class="trimmer-header-right">
        <button type="button" class="btn btn-secondary btn-sm" id="btnCancelTrimmer">Cancel</button>
        <button type="button" class="btn btn-secondary btn-sm btn-add-piece" id="btnAddCutPiece">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          <span>+ Add Split Piece</span>
        </button>
        <button type="button" class="btn btn-primary btn-sm btn-accent-glow" id="btnApplyCut">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="6" cy="6" r="3"></circle>
            <circle cx="6" cy="18" r="3"></circle>
            <line x1="20" y1="4" x2="8.12" y2="15.88"></line>
            <line x1="14.47" y1="14.48" x2="20" y2="20"></line>
            <line x1="8.12" y1="8.12" x2="12" y2="12"></line>
          </svg>
          <span id="btnApplyCutText">Apply & Cut PDF</span>
        </button>
      </div>
    </header>

    <!-- Floating Exit Fullscreen Button (Only visible in fullscreen) -->
    <button type="button" class="fullscreen-exit-btn" id="btnExitFullscreen">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
      <span>Exit Fullscreen</span>
    </button>

    <!-- Main Studio Body -->
    <main class="trimmer-viewport">
      <!-- Live Monitor Viewer -->
      <div class="trimmer-monitor-container">
        <div class="monitor-screen" id="monitorScreen">
          <canvas id="trimmerMonitorCanvas" class="monitor-canvas"></canvas>
          <div class="monitor-loading-spinner" id="monitorLoading">
            <div class="spinner-ring"></div>
            <span>Rendering Page...</span>
          </div>
        </div>

        <!-- Floating Monitor Controls (Zoom & Fullscreen) -->
        <div class="monitor-floating-tools">
          <button type="button" class="btn-monitor-tool" id="btnZoomOut">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
          </button>
          <button type="button" class="zoom-level-pill" id="zoomLevelPill">100%</button>
          <button type="button" class="btn-monitor-tool" id="btnZoomIn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="11" y1="8" x2="11" y2="14"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
          </button>
          <div class="tool-divider"></div>
          <button type="button" class="btn-monitor-tool" id="btnToggleFullscreen">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
            </svg>
          </button>
        </div>

        <!-- Quick Side Steppers -->
        <button type="button" class="monitor-nav-btn prev" id="btnMonitorPrev">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button type="button" class="monitor-nav-btn next" id="btnMonitorNext">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>

      <!-- Transport Controls Bar: Pure Range Trimming Dock -->
      <div class="trimmer-transport-bar">
        <!-- Left: Counter Info Display -->
        <div class="transport-counter-badge" id="monitorPageBadge">
          <span>PAGE <strong id="monitorCurrentPageNum">1</strong> OF <strong id="monitorTotalPagesNum">1</strong></span>
          <span class="badge-sub-sep">•</span>
          <span class="badge-sub-text">Selected <strong id="monitorSelectedPosition">1 of 1</strong></span>
        </div>

        <!-- Center: Mark In / Mark Out / Reset Range -->
        <div class="transport-group mark-actions" id="transportMarkActions">
          <button type="button" class="btn-transport-mark" id="btnMarkIn">
            <span class="mark-icon">[</span>
            <span>Set In</span>
          </button>
          <button type="button" class="btn-transport-mark" id="btnMarkOut">
            <span>Set Out</span>
            <span class="mark-icon">]</span>
          </button>
          <div class="reset-btn-wrapper">
            <button type="button" class="btn-transport-reset btn-danger-reset" id="btnResetRange">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                <path d="M3 3v5h5"></path>
              </svg>
              <span>Reset All</span>
            </button>
            <div class="danger-tooltip-popup" role="tooltip">
              <div class="danger-tooltip-content">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="danger-tooltip-svg">
                  <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                  <line x1="12" y1="9" x2="12" y2="13"></line>
                  <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
                <span>Discards all cut marks & resets all pages</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: History Tools -->
        <div class="transport-tools-group">
          <!-- Undo / Redo Pair -->
          <div class="tool-btn-pair">
            <button type="button" class="btn-transport-tool" id="btnStudioUndo">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 7v6h6"></path>
                <path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"></path>
              </svg>
              <span>Undo</span>
            </button>
            <button type="button" class="btn-transport-tool" id="btnStudioRedo">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 7v6h-6"></path>
                <path d="M3 17a9 9 0 0 1 9-9 9 9 0 0 1 6 2.3L21 13"></path>
              </svg>
              <span>Redo</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Filmstrip Timeline Track -->
      <div class="trimmer-timeline-section">
        <!-- Interactive Split Parts & Chapter Markers -->
        <div class="studio-parts-overview" id="studioPartsOverview">
          <div class="parts-overview-track" id="studioPartsTrack">
            <!-- Dynamic part badges rendered here -->
          </div>
        </div>

        <div class="timeline-scroll-wrapper" id="timelineScrollWrapper">
          <div class="timeline-track" id="timelineTrack">
            <!-- Dynamic page cards rendered here -->
          </div>
        </div>
      </div>
    </main>
  </div>
</div>
