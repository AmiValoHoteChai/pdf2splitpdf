---
// src/pages/404.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="404 - Page Not Found | pdf2splitpdf" description="The page you requested could not be found. Return to pdf2splitpdf to split PDF documents locally in your browser.">
  <div class="app-container error-page-layout">
    <a href="/" class="header-link-wrapper" aria-label="Return to Homepage">
      <Header />
    </a>

    <main class="main-content error-stage">
      <div class="error-ambient-glow"></div>

      <div class="error-hero">
        <div class="error-glitch-code" aria-hidden="true">404</div>
        <h1 class="error-main-heading">Page Not Found</h1>
        <p class="error-sub-text">
          The page or file you are looking for doesn't exist, has been moved, or the link may be broken.
        </p>

        <div class="error-actions">
          <a href="/" class="btn btn-primary btn-error-home">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            <span>Return to Splitter</span>
          </a>
        </div>
      </div>
    </main>

    <Footer />
  </div>
</Layout>
